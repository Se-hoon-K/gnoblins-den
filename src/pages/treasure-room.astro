---
import Room from '../layouts/Room.astro';
import Exhibit from '../components/Exhibit.astro';
import Prop from '../components/Prop.astro';
import { games } from '../data/games';
---

<Room title="Treasure Room | Gnoblin's Den">
  <section class="room treasure">
    <div class="wrap">
      <header class="room-head">
        <h1 class="display">Treasure Room</h1>
        <p class="lede ink-note">Every game we've dug up so far. Handle with care. Some of them bite.</p>
      </header>

      <!-- The hoard: a mossy shelf (candle, skull, a lot of mushrooms), floating bits, a heap of gold.
           All placeholder props. -->
      <div class="shelf" aria-hidden="true">
        <Prop name="mushroom-tiny" x="0%" y="6px" size={50} sit />
        <Prop name="candle" x="5%" y="10px" size={84} sit />
        <Prop name="mushroom-cluster" x="15%" y="6px" size={78} sit />
        <Prop name="skull" x="26%" y="8px" size={76} rotate={-4} sit />
        <Prop name="mushroom-tall" x="36%" y="6px" size={92} sit hideSmall />
        <Prop name="mushroom-tiny" x="45%" y="6px" size={52} sit hideSmall />
        <Prop name="mushroom-acid" x="52%" y="6px" size={72} sit />
        <Prop name="mushroom-cluster" x="62%" y="6px" size={86} sit hideSmall />
        <Prop name="mushroom-magenta" x="73%" y="6px" size={66} sit hideSmall />
        <Prop name="mushroom-tall" x="81%" y="6px" size={80} sit />
        <Prop name="mushroom-tiny" x="91%" y="6px" size={54} sit hideSmall />
        <div class="plank"></div>
        <svg class="moss" viewBox="0 0 1000 70" preserveAspectRatio="none">
          <path
            d="M0 20 C30 6 50 18 80 10 C110 2 130 18 170 12 C210 4 230 16 270 10 C310 2 340 18 380 12 C420 6 450 16 490 8 C530 2 560 18 600 12 C640 6 670 16 710 10 C750 2 780 18 820 12 C860 6 890 16 930 10 C960 6 980 14 1000 12 V34 C980 40 960 56 950 34 C930 40 900 34 880 36 C860 44 850 66 836 36 C800 40 760 34 720 36 C700 42 690 58 676 36 C640 40 600 34 560 36 C540 44 532 62 520 36 C480 40 440 34 400 36 C380 40 372 54 360 36 C320 40 280 34 240 36 C220 44 212 64 198 36 C160 40 120 34 80 36 C60 42 54 56 44 36 C30 38 12 34 0 34Z"
            fill="#3f6b1f"
            stroke="#121014"
            stroke-width="4"
            stroke-linejoin="round"
          />
          <path d="M40 16 q10 -6 20 0 M220 14 q12 -8 24 0 M430 12 q10 -6 20 0 M640 14 q12 -8 24 0 M880 14 q10 -6 20 0" stroke="#86c43a" stroke-width="5" fill="none" stroke-linecap="round" />
          <g fill="#b6ff2e"><circle cx="120" cy="22" r="2.5" /><circle cx="330" cy="20" r="2" /><circle cx="560" cy="24" r="2.5" /><circle cx="770" cy="20" r="2" /><circle cx="950" cy="22" r="2.5" /></g>
        </svg>
      </div>

      <div class="hoard-float" aria-hidden="true">
        <Prop name="eyeball" x="-4%" y="18%" size={58} rotate={-10} hideSmall />
        <Prop name="crystal" x="98%" y="30%" size={64} rotate={8} hideSmall />
        <Prop name="duck" x="-3%" y="70%" size={60} rotate={14} hideSmall />
        <Prop name="controller" x="97%" y="78%" size={66} rotate={-16} hideSmall />
      </div>

      <div class="exhibits">
        {games.map((game) => <Exhibit game={game} />)}
      </div>

      <div class="gold-heap" aria-hidden="true">
        <svg viewBox="0 0 600 140" preserveAspectRatio="none">
          <path d="M10 138 C60 70 150 40 300 34 C450 40 540 70 590 138Z" fill="#c99a16" stroke="#121014" stroke-width="5" stroke-linejoin="round" />
          <path d="M120 96 q20 -10 40 0 M260 70 q20 -10 40 0 M400 90 q20 -10 40 0 M200 120 q16 -8 32 0 M340 116 q16 -8 32 0" stroke="#f5ff3d" stroke-width="5" fill="none" stroke-linecap="round" />
        </svg>
        <Prop name="coins" x="12%" y="-34px" size={80} rotate={-6} />
        <Prop name="die" x="40%" y="-48px" size={60} rotate={20} />
        <Prop name="coins" x="62%" y="-30px" size={74} rotate={8} />
        <Prop name="mushroom-magenta" x="82%" y="-30px" size={64} rotate={-4} hideSmall />
      </div>
    </div>
  </section>
</Room>
