---
import Room from '../layouts/Room.astro';
import CtaPair from '../components/CtaPair.astro';
import { games } from '../data/games';

const game = games.find((g) => g.slug === 'the-fog')!;
---

<Room title={`${game.name} | Gnoblin's Den`} description={`${game.name}: ${game.tagline}`} game={game.slug} theme={game.theme}>
  <div class="fog-page">
    <!-- Only visible where the flashlight lands. Pure decoration. -->
    <div class="fog-hidden" aria-hidden="true">
      <span class="scrawl scrawl-big" style="left:56%;top:7%;rotate:-6deg">DON'T SPLIT UP</span>
      <span class="scrawl" style="left:6%;top:30%;rotate:4deg">day 12</span>
      <span class="scrawl tally" style="left:78%;top:34%">||||| ||||| |||</span>
      <span class="scrawl" style="left:62%;top:58%;rotate:-3deg">they come when it's quiet</span>
      <span class="scrawl" style="left:4%;top:72%;rotate:-8deg">EXIT? →</span>
      <span class="scrawl scrawl-big" style="left:30%;top:88%;rotate:3deg">RUN!</span>
      <svg class="hand" style="left:84%;top:14%;rotate:18deg" viewBox="0 0 60 80"><path d="M18 78 C8 60 6 46 10 36 L8 14 C8 8 15 8 16 14 L18 32 L20 6 C20 0 28 0 28 6 L29 30 L32 4 C32 -2 40 -1 40 5 L39 32 L44 12 C45 6 52 8 51 14 L47 42 C54 38 60 42 56 50 C50 62 44 72 40 78Z" /></svg>
      <svg class="hand" style="left:12%;top:50%;rotate:-24deg" viewBox="0 0 60 80"><path d="M18 78 C8 60 6 46 10 36 L8 14 C8 8 15 8 16 14 L18 32 L20 6 C20 0 28 0 28 6 L29 30 L32 4 C32 -2 40 -1 40 5 L39 32 L44 12 C45 6 52 8 51 14 L47 42 C54 38 60 42 56 50 C50 62 44 72 40 78Z" /></svg>
      <svg class="hand" style="left:46%;top:44%;rotate:8deg" viewBox="0 0 60 80"><path d="M18 78 C8 60 6 46 10 36 L8 14 C8 8 15 8 16 14 L18 32 L20 6 C20 0 28 0 28 6 L29 30 L32 4 C32 -2 40 -1 40 5 L39 32 L44 12 C45 6 52 8 51 14 L47 42 C54 38 60 42 56 50 C50 62 44 72 40 78Z" /></svg>
      <svg class="figure" style="left:88%;top:62%" viewBox="0 0 40 140"><circle cx="20" cy="12" r="10" /><path d="M12 24 H28 L30 92 L26 140 H22 L20 96 L18 140 H14 L10 92Z" /><path d="M10 28 L2 96 M30 28 L38 96" stroke-width="5" /></svg>
      <svg class="figure" style="left:20%;top:16%;scale:.7" viewBox="0 0 40 140"><circle cx="20" cy="12" r="10" /><path d="M12 24 H28 L30 92 L26 140 H22 L20 96 L18 140 H14 L10 92Z" /><path d="M10 28 L2 96 M30 28 L38 96" stroke-width="5" /></svg>
    </div>

    <section class="fog-hero wrap">
      <p class="fog-kicker">Gnoblin's Den presents</p>
      <h1 class="fog-title">{game.name}</h1>
      <p class="fog-tagline">{game.tagline}</p>
      <p class="fog-scratch">{game.players} · {game.genre} · {game.session}</p>
      <p class="fog-blurb">{game.blurb}</p>
      <CtaPair game={game} class="fog-cta" />
      <p class="fog-hint" aria-hidden="true">move your light around. something's written on the walls.</p>
    </section>

    <section class="fog-section wrap">
      <figure class="fog-keyart">
        {
          game.trailer ? (
            <iframe src={game.trailer} title={`${game.name} trailer`} allowfullscreen loading="lazy" />
          ) : (
            <div class="fog-keyart-empty">
              <span>{game.name}</span>
              <small>[trailer / key art goes here]</small>
            </div>
          )
        }
      </figure>
    </section>

    {
      game.screenshots.length > 0 && (
        <section class="fog-section wrap">
          <h2 class="fog-h2">Recovered photos</h2>
          <div class="polaroids">
            {game.screenshots.map((s, i) => (
              <figure class="polaroid" style={`--tilt:${[-4, 3, -2, 5][i % 4]}deg`}>
                <img src={s.src} alt={s.alt} loading="lazy" />
                {s.caption && <figcaption>{s.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      game.news.length > 0 && (
        <section class="fog-section wrap">
          <h2 class="fog-h2">Field notes</h2>
          <div class="notes">
            {game.news.map((n, i) => (
              <article class="note" style={`--tilt:${[1.5, -2, 1][i % 3]}deg`}>
                <time>{n.date}</time>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="fog-section wrap fog-end">
      <CtaPair game={game} class="fog-cta" />
      <a class="fog-back" href="/#map">← back to the den (if you can find it)</a>
    </section>
  </div>
</Room>

<script>
  // Flashlight: reveal .fog-hidden around the pointer. Wanders by itself when idle (e.g. on phones).
  const layer = document.querySelector<HTMLElement>('.fog-hidden');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (layer && !reduce) {
    let cx = innerWidth / 2, cy = innerHeight / 3, last = 0;
    const place = () => {
      const r = layer.getBoundingClientRect();
      layer.style.setProperty('--mx', `${cx - r.left}px`);
      layer.style.setProperty('--my', `${cy - r.top}px`);
    };
    addEventListener('pointermove', (e) => { cx = e.clientX; cy = e.clientY; last = performance.now(); place(); });
    addEventListener('scroll', place, { passive: true });
    const wander = (t: number) => {
      if (t - last > 2500) {
        cx = innerWidth * (0.5 + 0.35 * Math.sin(t / 2300));
        cy = innerHeight * (0.5 + 0.3 * Math.sin(t / 1700));
        place();
      }
      requestAnimationFrame(wander);
    };
    requestAnimationFrame(wander);
    place();
  }
</script>

<style>
  .fog-page { position: relative; font-family: 'Special Elite', monospace; color: #dfe7ea; }
  .fog-hero, .fog-h2 { text-shadow: 0 1px 2px #000, 0 0 18px #000, 0 0 36px #000c; }

  /* Hidden scrawls under the flashlight */
  .fog-hidden {
    position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden;
    --mx: -500px; --my: -500px;
    mask-image: radial-gradient(circle 210px at var(--mx) var(--my), #000 25%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle 210px at var(--mx) var(--my), #000 25%, transparent 100%);
  }
  .scrawl { position: absolute; font-family: 'Special Elite', monospace; font-size: 1.6rem; color: #b8a99a; white-space: nowrap; letter-spacing: 0.04em; }
  .scrawl-big { font-size: clamp(2.4rem, 7vw, 4.6rem); color: #8f2f26; text-shadow: 0 3px 0 #5a1a14; }
  .tally { letter-spacing: 0.3em; font-size: 2rem; }
  .hand { position: absolute; width: 70px; fill: #6d1f19; opacity: 0.85; }
  .figure { position: absolute; width: 46px; fill: #050708; stroke: #050708; stroke-linecap: round; opacity: 0.95; }
  @media (max-width: 600px) { .scrawl-big { font-size: 2rem; } .scrawl { font-size: 1.2rem; } }
  @media (prefers-reduced-motion: reduce) { .fog-hidden { mask-image: none; -webkit-mask-image: none; opacity: 0.45; } }

  .fog-hero, .fog-section { position: relative; z-index: 1; }
  .fog-hero { min-height: calc(100svh - 70px); display: flex; flex-direction: column; justify-content: center; padding: 60px 0; }
  .fog-kicker { margin: 0 0 8px; letter-spacing: 0.3em; text-transform: uppercase; font-size: 0.85rem; color: #8ea2a8; }
  .fog-title { font: 400 clamp(4rem, 15vw, 10rem)/0.9 'Special Elite', monospace; margin: 0 0 18px; color: #eef3f4; text-shadow: 0 0 30px #cfe3e855; animation: flicker 2.4s steps(1) 1 both; }
  @keyframes flicker { 0% { opacity: 0; } 8% { opacity: 1; } 12% { opacity: 0.2; } 18% { opacity: 1; } 40% { opacity: 0.4; } 44% { opacity: 1; } 100% { opacity: 1; } }
  .fog-tagline { font-size: clamp(1.2rem, 3vw, 1.6rem); margin: 0 0 12px; max-width: 36ch; }
  .fog-scratch { color: #9fb3ba; margin: 0 0 18px; }
  .fog-blurb { max-width: 60ch; margin: 0 0 32px; color: #c3cfd2; font-family: var(--font-body); }
  .fog-hint { margin-top: 36px; color: #6f8a94; font-size: 0.9rem; }

  .fog-page :global(.cta-btn) { font-family: 'Special Elite', monospace; font-size: 1.1rem; color: #0b1013; background: #dfe7ea; border: 2px solid #dfe7ea; box-shadow: 0 0 24px #cfe3e840; transition: box-shadow 0.2s; }
  .fog-page :global(.cta-btn:hover) { box-shadow: 0 0 40px #fff5d8aa; }
  .fog-page :global(.cta-discord) { background: transparent; color: #dfe7ea; }
  .fog-page :global(.cta-btn.is-soon) { background: transparent; color: #9fb3ba; border-style: dashed; box-shadow: none; }

  .fog-section { padding: 48px 0; }
  .fog-h2 { font: 400 clamp(1.8rem, 5vw, 2.6rem)/1 'Special Elite', monospace; color: #eef3f4; margin: 0 0 28px; }

  .fog-keyart { margin: 0; aspect-ratio: 16 / 9; border: 2px solid #3a474c; background: #070a0c; box-shadow: 0 0 60px #000; }
  .fog-keyart iframe { width: 100%; height: 100%; border: 0; }
  .fog-keyart-empty { height: 100%; display: grid; place-content: center; text-align: center; gap: 10px; background: radial-gradient(60% 50% at 50% 70%, #9fb3ba33, transparent), #070a0c; }
  .fog-keyart-empty span { font-size: clamp(2.4rem, 8vw, 5rem); color: #dfe7ea; }
  .fog-keyart-empty small { color: #6f8a94; }

  .polaroids { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 40px 32px; padding: 10px; }
  .polaroid { position: relative; margin: 0; padding: 12px 12px 48px; background: #e9e4d8; rotate: var(--tilt); box-shadow: 0 18px 30px #000a; transition: rotate 0.3s, scale 0.3s; }
  .polaroid:hover { rotate: 0deg; scale: 1.04; z-index: 2; }
  .polaroid::before { content: ''; position: absolute; top: -14px; left: 50%; width: 90px; height: 28px; translate: -50% 0; rotate: -3deg; background: #d8d0b8cc; box-shadow: 0 2px 4px #0004; }
  .polaroid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(0.4) contrast(1.1); }
  .polaroid figcaption { position: absolute; left: 0; right: 0; bottom: 10px; text-align: center; font: 400 1.4rem var(--font-hand); color: #1b1b1b; }

  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 28px; }
  .note {
    padding: 24px 24px 28px; color: #1d1d1d; rotate: var(--tilt);
    background: repeating-linear-gradient(180deg, transparent 0 27px, #9bb3c855 27px 28px), #ece6d3;
    clip-path: polygon(0 2%, 6% 0, 12% 2%, 20% 0, 30% 1.5%, 42% 0, 55% 2%, 66% 0, 78% 1.5%, 90% 0, 100% 2%, 100% 100%, 0 100%);
    box-shadow: 0 16px 28px #0009;
  }
  .note time { font-size: 0.85rem; color: #6b5d4a; }
  .note h3 { font: 400 1.5rem/1.2 var(--font-hand); margin: 6px 0 6px; color: #7a1f17; }
  .note p { margin: 0; font: 400 1.15rem/28px var(--font-hand); }

  .fog-end { display: grid; gap: 28px; justify-items: start; padding-bottom: 80px; }
  .fog-back { color: #8ea2a8; }
</style>
