---
import Room from '../layouts/Room.astro';
import ItemCard from '../components/ItemCard.astro';
import { games, type Game } from '../data/games';

export function getStaticPaths() {
  return games.map((game) => ({ params: { game: game.slug }, props: { game } }));
}

const { game } = Astro.props as { game: Game };
---

<Room title={`${game.name} | Gnoblin's Den`} description={`${game.name}: ${game.tagline}`} game={game.slug} theme={game.theme}>
  <section class="room game-room">
    <div class="wrap">
      <div class="game-hero">
        <div class="game-intro">
          <h1 class="game-title">{game.name}</h1>
          <p class="game-tagline">{game.tagline}</p>
          <div class="ink-panel game-blurb">
            <p>{game.blurb}</p>
          </div>
        </div>
        <ItemCard game={game} />
      </div>

      <!-- Key art slot: the game's world until real art/trailer exists. -->
      <figure class="key-art">
        {
          game.trailer ? (
            <iframe class="trailer" src={game.trailer} title={`${game.name} trailer`} allowfullscreen loading="lazy" />
          ) : (
            <div class="case-interior" data-game={game.slug}>
              <span class="case-title">{game.name}</span>
              {game.ticker && <div class="ticker running" aria-hidden="true"><span>{game.ticker.repeat(3)}</span></div>}
              <span class="key-art-note">[key art / trailer goes here]</span>
            </div>
          )
        }
      </figure>

      {
        game.features.length > 0 && (
          <section class="game-section ink-panel">
            <h2>What's inside</h2>
            <ul class="features">
              {game.features.map((f) => <li>{f}</li>)}
            </ul>
          </section>
        )
      }

      {
        game.screenshots.length > 0 && (
          <section class="game-section">
            <h2>Screenshots</h2>
            <div class="screens">
              {game.screenshots.map((s) => <img src={s.src} alt={s.alt} loading="lazy" />)}
            </div>
          </section>
        )
      }

      <a class="btn btn-ghost back" href="/treasure-room">← Back to the Treasure Room</a>
    </div>
  </section>
</Room>
