---
interface Props {
  name: string;
  title: string;
  role: string;
  color: string;
  avatar?: string;
}
const { name, title, role, color, avatar } = Astro.props;
---

<article class="crew-card" style={`--c:${color}`}>
  {
    avatar ? (
      <img class="avatar" src={avatar} alt="" />
    ) : (
      <svg class="avatar" viewBox="0 0 120 140" aria-hidden="true">
        <path d="M60 4 L94 68 H26 Z" fill="var(--c)" />
        <ellipse cx="60" cy="70" rx="40" ry="7" fill="var(--c)" opacity=".7" />
        <ellipse cx="60" cy="100" rx="34" ry="32" fill="#8fd11f" />
        <circle cx="47" cy="96" r="7" fill="#0d0b12" />
        <circle cx="73" cy="96" r="7" fill="#0d0b12" />
        <path d="M46 114 Q60 124 74 114" stroke="#0d0b12" stroke-width="4" fill="none" stroke-linecap="round" />
      </svg>
    )
  }
  <h2>{name}</h2>
  <p class="crew-title">{title}</p>
  <p class="crew-role">{role}</p>
</article>
